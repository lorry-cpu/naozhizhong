node_modules/
.pnpm-store/

# 源字体文件不进仓库；压缩后的开源字体包随项目分发。
public/fonts/*
!public/fonts/
!public/fonts/fonts.tar.gz
!public/fonts/OFL.txt
!public/fonts/NOTICE.txt
# 构建产物中的字体目录由 public/fonts/fonts.tar.gz 生成。
dist/fonts/
# 字体打包产物
release/

# 开发过程中的临时脚本与验证输出，不应进仓库
.diag*.mjs
.verify-*.mjs
tmp-*
verify-out/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
coverage/
*.tmp
*.log
